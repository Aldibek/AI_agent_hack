# Скопируйте этот файл в .env и укажите ключ хотя бы ОДНОГО провайдера.
# Никогда не коммитьте .env с реальными ключами.
#
# Каждый указанный провайдер становится отдельным ревьюером «консилиума» (до 3).
# С одним ключом агент работает полностью: делает 2 независимых прохода одной модели.

# --- Anthropic Claude (основной провайдер; ключ: https://platform.claude.com/settings/keys) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Глубина рассуждения ревьюеров: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# Claude: 3 прохода — общий, сверка разделов/терминология/ИБ, «два разработчика»
ANTHROPIC_FOCUS=0,2,3
# ANTHROPIC_FALLBACK=0                  # отключить server-side fallback при отказе модели
# ANTHROPIC_MIN_MAX_TOKENS=40000        # минимальный потолок ответа (reasoning входит в лимит; платим только за сгенерированное)

# --- Google Gemini (бесплатный ключ: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Актуальное имя модели смотрите в AI Studio; алиас ниже указывает на текущую Flash-модель
GEMINI_MODEL=gemini-flash-latest

# --- Groq (бесплатный ключ: https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (https://openrouter.ai/keys), укажите модель, например бесплатную ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- OpenAI или любой OpenAI-совместимый сервер (не по умолчанию) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Локальная модель (Ollama / vLLM) — данные не покидают компьютер ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# --- Роли (необязательно) ---
# Конфигурация команды для сдачи (по умолчанию):
REQAUDIT_REVIEWERS=anthropic
REQAUDIT_ORCHESTRATOR=anthropic
REQAUDIT_ORCH_MODEL=claude-sonnet-5-5   # оркестратор — Sonnet 5.5: склейка и формулировки, быстрее и дешевле Opus
REQAUDIT_JUDGE=anthropic
REQAUDIT_JUDGE_MODEL=claude-sonnet-5-5  # судья — другая модель, не участвовавшая в ревью
REQAUDIT_ORCH_EFFORT=medium             # effort оркестратора (по умолчанию — ANTHROPIC_EFFORT)
REQAUDIT_JUDGE_EFFORT=medium            # effort судьи
#   REQAUDIT_REVIEW_DEADLINE=480          # бюджет времени на одного ревьюера, сек
#   OPENAI_FOCUS=0,2,3                    # если ревьюер — OpenAI
#
# --- Контроль расходов (python -m reqaudit.costs — сводка по журналу .reqaudit_costs/ledger.jsonl) ---
REQAUDIT_BUDGET_USD=2.0                 # лимит на один прогон, $
REQAUDIT_DAILY_BUDGET_USD=15.0          # лимит за сутки, $
# REQAUDIT_PRICES_FILE=prices.json      # свои цены: {"model": {"input":..,"output":..,"cache_read":..,"cache_write":..}}
#
# Ревьюеры через запятую (без REQAUDIT_REVIEWERS — до 3 доступных провайдеров в порядке anthropic, gemini, groq, openrouter, openai, ollama)
# REQAUDIT_REVIEWERS=anthropic,gemini
# Судья (по умолчанию — провайдер, не участвовавший в ревью, если такой есть)
# REQAUDIT_JUDGE=groq
# Оркестратор (по умолчанию — первый ревьюер)
# REQAUDIT_ORCHESTRATOR=gemini
# Число проходов на одну модель (по умолчанию 2 при одной модели, 1 при нескольких)
# REQAUDIT_VARIANTS=2
