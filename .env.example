# Скопируйте этот файл в .env и укажите ключ хотя бы ОДНОГО провайдера.
# Никогда не коммитьте .env с реальными ключами.

# --- Anthropic Claude — основной провайдер (ключ: https://platform.claude.com/settings/keys) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Глубина рассуждения: low | medium | high | xhigh | max
ANTHROPIC_EFFORT=medium
# 3 прохода ревьюера: каждое требование · общий разбор за 5 ролей · «два разработчика»
ANTHROPIC_FOCUS=0,2,3

# --- Google Gemini — бесплатная альтернатива (ключ: https://aistudio.google.com/apikey) ---
# Если задан только этот ключ, агент работает целиком на Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- OpenAI (необязательно) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol

# --- Ревьюер и критик (конфигурация команды для сдачи) ---
REQAUDIT_REVIEWERS=anthropic
REQAUDIT_JUDGE=anthropic
REQAUDIT_JUDGE_MODEL=claude-opus-5-5
REQAUDIT_JUDGE_EFFORT=medium

# --- Контроль расходов (сводка: python -m reqaudit.costs) ---
REQAUDIT_BUDGET_USD=2.0
REQAUDIT_DAILY_BUDGET_USD=15.0

# --- Человек в контуре (--interactive): сколько вопросов задать там, где агент не уверен ---
# REQAUDIT_QUESTIONS=3
