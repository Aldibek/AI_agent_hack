# Скопируйте этот файл в .env и укажите ключ хотя бы ОДНОГО провайдера.
# Никогда не коммитьте .env с реальными ключами.
#
# Каждый указанный провайдер становится отдельным ревьюером «консилиума» (до 3).
# С одним ключом агент работает полностью: делает 2 независимых прохода одной модели.

# --- AlemLLM (alem.ai, Казахстан) — OpenAI-совместимый API ---
ALEM_API_KEY=
ALEM_BASE_URL=https://llm.alem.ai/v1
ALEM_MODEL=alemllm

# --- Gemma 4 через alem.ai (отдельный ключ в кабинете alem.ai) ---
GEMMA_API_KEY=
GEMMA_BASE_URL=https://llm.alem.ai/v1
GEMMA_MODEL=gemma4

# --- Google Gemini (бесплатный ключ: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Актуальное имя модели смотрите в AI Studio; алиас ниже указывает на текущую Flash-модель
GEMINI_MODEL=gemini-flash-latest

# --- Groq (бесплатный ключ: https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenRouter (https://openrouter.ai/keys), укажите модель, например бесплатную ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- OpenAI или любой OpenAI-совместимый сервер ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Локальная модель (Ollama / vLLM) — данные не покидают компьютер ---
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:14b

# --- Роли (необязательно) ---
# Конфигурация команды для сдачи:
#   REQAUDIT_REVIEWERS=openai,gemma       # alem подключается добавлением в список (медленная модель)
#   REQAUDIT_ORCHESTRATOR=openai
#   REQAUDIT_JUDGE=openai
#   REQAUDIT_JUDGE_MODEL=gpt-5.5          # судья — другая модель, не участвовавшая в ревью
#   REQAUDIT_REVIEW_DEADLINE=480          # бюджет времени на одного ревьюера, сек
#   OPENAI_FOCUS=0,2,3                    # GPT: 3 прохода — общий, сверка разделов/терминология/ИБ, «два разработчика»
#   REQAUDIT_ORCH_EFFORT=low              # reasoning effort оркестратора (быстрее при той же полноте)
#   REQAUDIT_JUDGE_EFFORT=low             # reasoning effort судьи
#   ALEM_MAX_FINDINGS=10                  # медленной модели — меньше находок, чтобы уложилась во время
#
# Ревьюеры через запятую (по умолчанию — до 3 доступных провайдеров в порядке alem, gemini, groq, openrouter, openai, ollama)
# REQAUDIT_REVIEWERS=alem,gemini
# Судья (по умолчанию — провайдер, не участвовавший в ревью, если такой есть)
# REQAUDIT_JUDGE=groq
# Оркестратор (по умолчанию — первый ревьюер)
# REQAUDIT_ORCHESTRATOR=alem
# Число проходов на одну модель (по умолчанию 2 при одной модели, 1 при нескольких)
# REQAUDIT_VARIANTS=2
